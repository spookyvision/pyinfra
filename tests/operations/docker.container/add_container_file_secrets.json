{
    "kwargs": {
        "container": "nginx",
        "image": "nginx:alpine",
        "secrets": [
            {
                "name": "mysecret"
            },
            {
                "name": "custom_secret",
                "target": "/tmp/extra_secure",
                "uid": "1000",
                "gid": "1000",
                "mode": "0777"
            }
        ],
        "present": "true",
        "start": false
    },
    "facts": {
        "docker.DockerContainer": {
            "object_id=nginx": []
        }
    },
    "commands": [
        "docker container create --name nginx --secret mysecret --secret custom_secret,target=/tmp/extra_secure,uid=1000,gid=1000,mode=0777 nginx:alpine"
    ]
}